# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Port the Express server runs on
PORT=5100

# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ai-travel-planner

# OR MongoDB Atlas (replace user, password and cluster host)
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-travel-planner

# Secret key used to sign and verify JWTs (login tokens).
# Generate your own random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Google Gemini API key. This is used by the backend only and is never sent to
# the frontend. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model used to generate itineraries
GEMINI_MODEL=gemini-3.5-flash-lite