# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Port the Express server runs on
PORT=5000

# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ai-travel-planner

# OR MongoDB Atlas (replace user, password and cluster host)
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-travel-planner